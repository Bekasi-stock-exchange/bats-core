# JAST core local development environment.
# Copy to .env and adjust.

# PostgreSQL DSN. REQUIRED — no default. The app fails fast at startup if unset.
DB_DSN=postgres://postgres:postgres@localhost:5432/bats?sslmode=disable

# ADMIN key, sent as the X-API-Key header. REQUIRED — no default.
# Broker keys are per-participant, stored hashed in the database, and issued through
# POST /api/admin/participants — they do not belong here.
API_KEY=your-secret-api-key

# HTTP server port. Default: 8080
HTTP_PORT=8080

# Log level: debug | info | warn | error. Default: info
LOG_LEVEL=info

# Disable the API documentation endpoints (/docs and /openapi.yaml). Default: false
DISABLE_DOCS=false
