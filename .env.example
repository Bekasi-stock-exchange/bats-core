# JAST core local development environment.
# Copy to .env and adjust. All variables are prefixed JAST_.

# PostgreSQL DSN. REQUIRED — no default. The app fails fast at startup if unset.
DB_DSN=postgres://postgres:postgres@localhost:5432/jast?sslmode=disable

# HTTP server port. Default: 8080
HTTP_PORT=8080

# Log level: debug | info | warn | error. Default: info
JAST_LOG_LEVEL=info
